<Project Sdk="Microsoft.NET.Sdk">

    <!-- ASSEMBLY BASIC PROPERTIES -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- ASSEMBLY ADDITIONAL PROPERTIES -->
    <PropertyGroup>
        <AssemblyName>fhstep</AssemblyName>
        <AssemblyTitle>Fahrenheit Symbol Table Parser</AssemblyTitle>
        <Product>Fahrenheit Symbol Table Parser</Product>
    </PropertyGroup>

    <!-- PUBLISH SETTINGS -->
    <PropertyGroup>
        <!-- STEP should not be part of 'deploy', hence unpublishable -->
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <!-- SHARED FILE LINKS -->
    <ItemGroup>
        <None Include="$(SolutionDir).editorconfig" Link=".editorconfig" />
    </ItemGroup>

    <!-- PROJECT REFERENCES -->
    <ItemGroup>
        <ProjectReference Include="..\core\Fahrenheit.csproj" />
    </ItemGroup>

    <!-- PACKAGE REFERENCES -->
    <ItemGroup>
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25306.1" />
    </ItemGroup>

    <!-- ASSET PACKAGING -->
    <ItemGroup>
        <None Include="data/*.ffx*.csv"  CopyToOutputDirectory="Always" />
        <None Include="data/*.ffx*.json" CopyToOutputDirectory="Always" />
        <None Include="data/*.ffx*.rsp"  CopyToOutputDirectory="Always" />
    </ItemGroup>

</Project>
